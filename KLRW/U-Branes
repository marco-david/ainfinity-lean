module
public import Mathlib
public import KLRW.KLRWAlgebra
@[expose] public section

section UBranes

variable {V : Type} [DecidableEq V] [Fintype V]
variable {n : Nat}

abbrev MarkedDisk := Fin n → V

structure UBrane (disk : @MarkedDisk V n) where
  label : V
  left : Fin (n+1)
  right : Fin (n+1)
  right_lt_left : left < right
  deriving DecidableEq, BEq

structure UBraneDiagram (disk : @MarkedDisk V n) (k : Nat) where
  branes : Fin k → UBrane disk
  non_intersecting : sorry  -- optional, but we might want to require a proof that the U branes, once superimposed onto the same 2D picture, do not self-intersect


section GeneratedKLRW

/- UBraneKLRWStruct builds a KLRWStructure from a UBraneDiagram.  -/
def UBraneKLRWStruct {k : Nat} {disk : @MarkedDisk V n} (Γ : SimpleDigraph V) (diag : UBraneDiagram disk k) : KLRWStructure V where
  Γ := Γ
  BlackStrands := fun v => (Finset.univ.filter (fun i : Fin k => (diag.branes i).label = v)).card
  RedStrands := fun v => (Finset.univ.filter (fun i : Fin n => disk i = v)).card

/- braneSection gets the section number for brane i in a given vertex. -/
def braneSection {disk : @MarkedDisk V n} (b : UBrane disk) (v : Fin 2) : Fin (n + 1) :=
  if v = 0 then b.right else b.left

/- braneStrandData returns the associated StrandData of any given uBrane. -/
def braneStrandData {disk : @MarkedDisk V n} (b : UBrane disk) : StrandData V :=
  ⟨b.label, .black⟩

/- branesInSection returns an ordered list of the indicies of branes in a given section of a specific vertex. -/
def branesInSection {disk : @MarkedDisk V n} {k : Nat} (diag : UBraneDiagram disk k)
    (vertex : Fin k → Fin 2) (sec : Fin (n + 1)) : List (Fin k) :=

  let rightBranes := (List.finRange k).filter fun i =>
    vertex i = 0 ∧ braneSection (diag.branes i) 0 = sec

  let leftBranes := ((List.finRange k).filter fun i =>
    vertex i = 1 ∧ braneSection (diag.branes i) 1 = sec).reverse

  rightBranes ++ leftBranes


/- sectionStrands gets all black strands in a given section, ordered right-ascending then left-descending. -/
  def sectionStrands {disk : @MarkedDisk V n} {k : Nat} (diag : UBraneDiagram disk k)
    (vertex : Fin k → Fin 2) (sec : Fin (n + 1)) : List (StrandData V) :=
  (branesInSection diag vertex sec).map
    (fun i => ⟨(diag.branes i).label, .black⟩)

/- vertexStrands builds the full strand sequence for a given vertex. -/
def vertexStrands {disk : @MarkedDisk V n} {k : Nat} (diag : UBraneDiagram disk k)
    (vertex : Fin k → Fin 2) : List (StrandData V) :=
  List.flatMap (fun sec =>
    let blacks := sectionStrands diag vertex sec
    if h : sec.val > 0 then
      (⟨disk ⟨sec.val - 1, by omega⟩, .red⟩ : StrandData V) :: blacks
    else
      blacks)
  (List.finRange (n + 1))

/- vertexStrandSeq proves vertexStrands can be turned into a vector of the expected length. -/
def vertexStrandSeq {disk : @MarkedDisk V n} {k : Nat} (Γ : SimpleDigraph V)
    (diag : UBraneDiagram disk k) (vertex : Fin k → Fin 2) :
    Vector (StrandData V) (totalStrands (UBraneKLRWStruct Γ diag)) :=
  ⟨(vertexStrands diag vertex).toArray,
   by sorry⟩

/- vertexObject turns vertexStrandSeq into a KLRWObject. -/
def vertexObject {disk : @MarkedDisk V n} {k : Nat} (Γ : SimpleDigraph V)
    (diag : UBraneDiagram disk k) (vertex : Fin k → Fin 2) :
    KLRWObject (UBraneKLRWStruct Γ diag) where
  strandSeq := vertexStrandSeq Γ diag vertex
  corr_num_black := sorry
  corr_num_red := sorry

/- vertexObject.WithRing adds a ring to vertexObject, making it a KLRWObject.WithRing. -/
def vertexObject.WithRing {k : Nat} {disk : @MarkedDisk V n} (R : Type) [CommRing R]
    (Γ : SimpleDigraph V) (diag : UBraneDiagram disk k) (vertex : Fin k → Fin 2) :
    KLRWObject.WithRing R (UBraneKLRWStruct Γ diag) where
  obj := vertexObject Γ diag vertex



/- updateVertex allows you to change the ith element of a a vertex to b. -/
def updateVertex {k : Nat} (i : Fin k) (b : Fin 2) (vertex : Fin k → Fin 2) : Fin k → Fin 2 :=
  Function.update vertex i b

/- movedIndicies returns a list of all the positions a vertex has 1. -/
def movedIndicies {k : Nat} (vertex : Fin k → Fin 2) : Finset (Fin k) :=
  Finset.univ.filter (fun i => vertex i = 1)

/- sectionSize returns the number of ubranes in any given section of a vertex. -/
def sectionSize {disk : @MarkedDisk V n} {k : Nat} (diag : UBraneDiagram disk k)
    (vertex : Fin k → Fin 2) (sec : Fin (n + 1)) : Nat :=
  (sectionStrands diag vertex sec).length + if sec.val > 0 then 1 else 0

/- strandsBeforeSection returns the total number of strands before any given section. -/
def strandsBeforeSection {disk : @MarkedDisk V n} {k : Nat} (diag : UBraneDiagram disk k)
    (vertex : Fin k → Fin 2) (sec : Fin (n + 1)) : Nat :=
  (Finset.Iio sec).sum (fun s => sectionSize diag vertex s)

/- strandPosition returns the index of the strand generated by the given U-brane at a vertex. -/
def strandPosition {disk : @MarkedDisk V n} {k : Nat} (diag : UBraneDiagram disk k)
    (vertex : Fin k → Fin 2) (i : Fin k) : Nat :=
  let sec := braneSection (diag.branes i) (vertex i)
  let before := strandsBeforeSection diag vertex sec
  let sameSection := branesInSection diag vertex sec
  before + List.idxOf i sameSection

/- crossesBetween finds list of StrandGenOp needed to move a strand from start to ending. -/
def crossesBetween {k : Nat} {disk : @MarkedDisk V n} (Γ : SimpleDigraph V) (diag : UBraneDiagram disk k) (vertex : Fin k → Fin 2) (start ending : Fin (n + k)) :
    List (StrandGenOp (UBraneKLRWStruct Γ diag)) :=
  if h : start.val = ending.val then []
  else if h : ending.val < start.val then
    (List.range (start.val - ending.val)).map
      (fun j => .cross ⟨start.val - j - 1, by sorry⟩)
  else
    (List.range (ending.val - start.val)).map
      (fun j => .cross ⟨start.val + j, by sorry⟩)

/- edgeHom builds the morphism to go from one vertex to another (if they only differ by 1 value). -/
noncomputable def edgeHom {disk : @MarkedDisk V n} {k : Nat} (R : Type*) [CommRing R]
    (Γ : SimpleDigraph V) (diag : UBraneDiagram disk k) (vertex : Fin k → Fin 2) (i : Fin k)
    (h : vertex i = 0) :
    KLRWHom R
      (vertexObject Γ diag vertex)
      (vertexObject Γ diag (Function.update vertex i 1)) := by

  let M := vertexObject Γ diag vertex
  let N := vertexObject Γ diag (Function.update vertex i 1)

  let start := (⟨strandPosition diag vertex i, by sorry⟩ : Fin (n + k))

  let ending := (⟨strandPosition diag (Function.update vertex i 1) i, by sorry⟩ : Fin (n + k))

  let ops := crossesBetween Γ diag vertex start ending

  have h_end : strandGenSeqEnd M ops = N := by
    sorry
 
  exact
    ⟨(KLRWRel R (UBraneKLRWStruct Γ diag)).mk' (strandGenSeq M ops),
      strandGenSeq_mem_KLRWHom_of_eq (R := R) M N ops h_end⟩


end GeneratedKLRW
end UBranes
