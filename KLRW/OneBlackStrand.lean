module

public import Mathlib
public import Util.Texify
public meta import Util.Texify
public import ComputableCochainComplex.AdditiveCompletion
public import ComputableCochainComplex.BoundedCochainComplex

@[expose] public section

open CategoryTheory

namespace AInfinityTheory

universe v u
variable {R : Type u} [CommRing R] [DecidableEq R] (C : Type u) [Category C]
variable {n : ℕ}

structure KLRWCategory (n : ℕ) (R : Type u) where
  positioning : Fin (n + 1)

instance : Texify (KLRWCategory n R) where
  texify x := s!"T_\{{x.positioning}}"
  requiresParentheses := false

def compShift {n : ℕ} {R : Type u}
    (X Y Z : KLRWCategory n R) : ℕ :=
  max X.positioning.val Y.positioning.val +
      max Y.positioning.val Z.positioning.val -
      max X.positioning.val Z.positioning.val -
      Y.positioning.val

lemma compShift_self_left {n : ℕ} {R : Type u}
    (X Y : KLRWCategory n R) :
    compShift X X Y = 0 := by
  dsimp [compShift]
  omega

lemma compShift_self_right {n : ℕ} {R : Type u}
    (X Y : KLRWCategory n R) :
    compShift X Y Y = 0 := by
  dsimp [compShift]
  omega

lemma compShift_assoc {n : ℕ} {R : Type u}
    (W X Y Z : KLRWCategory n R) :
    compShift W X Y + compShift W Y Z =
      compShift X Y Z + compShift W X Z := by
  dsimp [compShift]
  omega

/--
The free module generated by the strands with fixed channels.
This is an abbrev because we want it to inherit the Module typeclass instance from DFinsupp.

Uses DFinsupp because Finsupp is not currently computable. See
https://leanprover.zulipchat.com/#narrow/channel/113489-new-members/topic/Finsupp.20noncomputability
-/
abbrev StrandSpace (R : Type u) [CommRing R] : Type u := Π₀ _ : ℕ, R

instance [ToString R] : Texify (StrandSpace R) where
  texify x :=
    -- Not sure if this computationally efficient
    let support := x.support
    if support = ∅ then
      "0"
    else
      support.sort (· ≥ ·) |>.map (termString x) |> " + ".intercalate
  requiresParentheses := true
  where termString (x : ℕ → R) (i : ℕ) :=
    let coefficient := x i
    if i = 0 then
      toString coefficient
    else
      let coefficientString :=
        if coefficient = 1 then ""
        else if coefficient = -1 then "-"
        else toString coefficient
      let powerString := if i = 1 then "" else s!"^\{{i}}"
      s!"{coefficientString}s{powerString}"

abbrev StrandSpace.dots (R : Type u) [CommRing R] (n : ℕ) : StrandSpace R :=
  DFinsupp.single n 1

section ConvolutionLemmas
variable {R : Type u} [CommRing R] [DecidableEq R]

private theorem sum_inner_zero (h : StrandSpace R) (k t : ℕ) :
    h.sum (fun l u => ((0 : R) * u) • StrandSpace.dots R (k + l + t)) = 0 := by
  simp [zero_mul, zero_smul]

private theorem sum_inner_add (h : StrandSpace R) (k t : ℕ) (a b : R) :
    h.sum (fun l u => ((a + b) * u) • StrandSpace.dots R (k + l + t)) =
    h.sum (fun l u => (a * u) • StrandSpace.dots R (k + l + t)) +
    h.sum (fun l u => (b * u) • StrandSpace.dots R (k + l + t)) := by
  simp only [add_mul, add_smul, DFinsupp.sum, Finset.sum_add_distrib]

private theorem smul_dots_sum_single_index {R : Type u} [CommRing R] [DecidableEq R]
    (c : R) (m : ℕ) (g : ℕ → R → StrandSpace R) (hg : g m 0 = 0) :
    (c • StrandSpace.dots R m).sum g = g m c := by
  rw [StrandSpace.dots, ← DFinsupp.single_smul, smul_eq_mul, mul_one,
      DFinsupp.sum_single_index hg]

private theorem smul_dots_sum_lhs {R : Type u} [CommRing R] [DecidableEq R]
    (c : R) (m t : ℕ) (h : StrandSpace R) :
    (c • StrandSpace.dots R m).sum
      (fun k s => h.sum (fun l u => (s * u) • StrandSpace.dots R (k + l + t))) =
    h.sum (fun l u => (c * u) • StrandSpace.dots R (m + l + t)) := by
  rw [StrandSpace.dots, ← DFinsupp.single_smul, smul_eq_mul, mul_one,
      DFinsupp.sum_single_index (by simp [zero_mul, zero_smul])]

private theorem smul_dots_sum_rhs {R : Type u} [CommRing R] [DecidableEq R]
    (c : R) (m : ℕ) (r : R) (i t : ℕ) :
    (c • StrandSpace.dots R m).sum
      (fun k s => (r * s) • StrandSpace.dots R (i + k + t)) =
    (r * c) • StrandSpace.dots R (i + m + t) := by
  rw [StrandSpace.dots, ← DFinsupp.single_smul, smul_eq_mul, mul_one,
      DFinsupp.sum_single_index (by simp [mul_zero, zero_smul])]

end ConvolutionLemmas

instance : Category (KLRWCategory n R) where
  Hom X Y := StrandSpace R
  id X := StrandSpace.dots R 0
  comp {X Y Z} g h :=
    g.sum (fun i r => h.sum (fun j s =>
      (r * s) • StrandSpace.dots R (i + j + compShift X Y Z)))
  id_comp f := by
    rw [compShift_self_left]
    simp only [StrandSpace.dots]
    rw [DFinsupp.sum_single_index (by simp [zero_mul, zero_smul])]
    simp only [one_mul, zero_add, add_zero, ← DFinsupp.single_smul, smul_eq_mul, mul_one]
    exact DFinsupp.sum_single
  comp_id f := by
    rw [compShift_self_right]
    simp only [StrandSpace.dots]
    conv_lhs =>
      arg 2; ext i r
      rw [DFinsupp.sum_single_index (by simp [mul_zero, zero_smul])]
    simp [mul_one, add_zero, ← DFinsupp.single_smul, smul_eq_mul]
  assoc {W X Y Z} f g h := by
    -- Flatten LHS outer sum: pull f.sum out
    rw [DFinsupp.sum_sum_index (fun k => sum_inner_zero h k (compShift W Y Z))
          (fun k a b => sum_inner_add h k (compShift W Y Z) a b)]
    congr 1; funext i; funext r
    -- Flatten LHS inner sum: pull g.sum out
    rw [DFinsupp.sum_sum_index
          (fun k => sum_inner_zero h k (compShift W Y Z))
          (fun k a b => sum_inner_add h k (compShift W Y Z) a b)]
    -- Reduce (c • dots m).sum on LHS
    simp_rw [smul_dots_sum_lhs]
    -- LHS = g.sum(fun j s => h.sum(fun l u =>
    --   ((r*s)*u) • dots((i+j+compShift W X Y)+l+compShift W Y Z)))
    -- Flatten RHS: pull g.sum out
    symm
    rw [DFinsupp.sum_sum_index
          (fun k => by simp [mul_zero, zero_smul])
          (fun k a b => by simp [mul_add, add_smul])]
    congr 1; funext j; funext s
    -- Flatten RHS inner sum: pull h.sum out
    rw [DFinsupp.sum_sum_index
          (fun k => by simp [mul_zero, zero_smul])
          (fun k a b => by simp [mul_add, add_smul])]
    -- Reduce (c • dots m).sum on RHS
    simp_rw [smul_dots_sum_rhs]
    -- RHS = h.sum(fun l u =>
    --   (r*(s*u)) • dots(i+(j+l+compShift X Y Z)+compShift W X Z))
    symm
    -- Compare pointwise
    congr 1; funext l; funext u
    rw [mul_assoc]
    congr 1
    simpa [add_assoc, add_left_comm, add_comm] using
      congrArg (fun t => StrandSpace.dots R (i + j + l + t)) (compShift_assoc W X Y Z)

instance : Preadditive (KLRWCategory n R) where
  homGroup P Q := inferInstanceAs (AddCommGroup (StrandSpace R))
  add_comp := by
    intro P Q S f f' g
    letI : AddCommMonoid (StrandSpace R) := inferInstance
    exact DFinsupp.sum_add_index (fun k => sum_inner_zero g k (compShift P Q S))
      (fun k a b => sum_inner_add g k (compShift P Q S) a b)
  comp_add := by
    intro P Q S f g g'
    letI : AddCommMonoid (StrandSpace R) := inferInstance
    suffices h : (f : StrandSpace R).sum (fun i r =>
        (g + g' : StrandSpace R).sum
          (fun j s => (r * s) • StrandSpace.dots R (i + j + compShift P Q S))) =
      (f : StrandSpace R).sum (fun i r =>
        (g : StrandSpace R).sum
          (fun j s => (r * s) • StrandSpace.dots R (i + j + compShift P Q S))) +
      (f : StrandSpace R).sum (fun i r =>
        (g' : StrandSpace R).sum
          (fun j s => (r * s) • StrandSpace.dots R (i + j + compShift P Q S)))
      from h
    conv_lhs =>
      arg 2; ext i r
      rw [DFinsupp.sum_add_index (fun j => by simp [mul_zero, zero_smul])
        (fun j s₁ s₂ => by simp [mul_add, add_smul])]
    simp only [DFinsupp.sum, Finset.sum_add_distrib]

/-- `DFinsupp` analogue of `Finsupp.sum_smul_index`: summing over a scaled strand multiplies the
coefficients fed to the summand by the scalar. -/
theorem StrandSpace.sum_smul_index {γ : Type*} [AddCommMonoid γ] (r : R) (f : StrandSpace R)
    (h : ℕ → R → γ) (h0 : ∀ i, h i 0 = 0) :
    (r • f).sum h = f.sum fun i c => h i (r * c) := by
  rw [show r • f = DFinsupp.mapRange (fun _ c => r * c) (fun _ => mul_zero r) f from by
      ext k; simp,
    DFinsupp.sum_mapRange_index h0]

/-- Scalars pull out of the first factor of the convolution composition. -/
theorem StrandSpace.convolution_smul_left (r : R) (f g : StrandSpace R) (t : ℕ) :
    (r • f).sum (fun i c => g.sum fun j s => (c * s) • StrandSpace.dots R (i + j + t)) =
      r • f.sum (fun i c => g.sum fun j s => (c * s) • StrandSpace.dots R (i + j + t)) := by
  rw [StrandSpace.sum_smul_index r f _ (fun i => by simp [zero_mul, zero_smul]),
    DFinsupp.smul_sum]
  congr 1; funext i c
  rw [DFinsupp.smul_sum]
  congr 1; funext j s
  rw [smul_smul, mul_assoc]

/-- Scalars pull out of the second factor of the convolution composition. -/
theorem StrandSpace.convolution_smul_right (r : R) (f g : StrandSpace R) (t : ℕ) :
    f.sum (fun i c => (r • g).sum fun j s => (c * s) • StrandSpace.dots R (i + j + t)) =
      r • f.sum (fun i c => g.sum fun j s => (c * s) • StrandSpace.dots R (i + j + t)) := by
  conv_lhs =>
    arg 2; ext i c
    rw [StrandSpace.sum_smul_index r g _ (fun j => by simp [mul_zero, zero_smul])]
  rw [DFinsupp.smul_sum]
  congr 1; funext i c
  rw [DFinsupp.smul_sum]
  congr 1; funext j s
  rw [smul_smul, mul_left_comm]

/-- The KLRW category is `R`-linear: its Hom-spaces are `StrandSpace R`, and the convolution
composition is `R`-bilinear. -/
instance : Linear R (KLRWCategory n R) where
  homModule _ _ := inferInstanceAs (Module R (StrandSpace R))
  smul_comp P Q S r f g := StrandSpace.convolution_smul_left r f g (compShift P Q S)
  comp_smul P Q S f r g := StrandSpace.convolution_smul_right r f g (compShift P Q S)

instance (R : Type*) [CommRing R] [DecidableEq R] [ToString R] (n : ℕ) (S T : KLRWCategory n R) :
  Texify (S ⟶ T) := inferInstanceAs (Texify (StrandSpace R))

/-- A positioning is a zero object of the KLRW category exactly when the ring of coefficients is
trivial: its identity is the dotless strand `StrandSpace.dots R 0 = DFinsupp.single 0 1`, which
vanishes iff `(1 : R) = 0`. -/
theorem KLRWCategory.isZero_iff (A : KLRWCategory n R) : Limits.IsZero A ↔ (1 : R) = 0 := by
  rw [Limits.IsZero.iff_id_eq_zero]
  exact DFinsupp.single_eq_zero

/-- Over a nontrivial ring, the KLRW category has no zero objects. -/
theorem KLRWCategory.not_isZero [Nontrivial R] (A : KLRWCategory n R) : ¬ Limits.IsZero A :=
  fun h => one_ne_zero (A.isZero_iff.mp h)

/-- Whether a positioning is a zero object is decidable: it amounts to `(1 : R) = 0`. -/
instance : DecidablePred (Limits.IsZero : KLRWCategory n R → Prop) :=
  fun A => decidable_of_iff _ A.isZero_iff.symm

abbrev AddKLRWCategory (n : ℕ) (R : Type u) [CommRing R] [DecidableEq R] : Type _ :=
  CMat_ (KLRWCategory n R)

abbrev KLRWComplexCategory (n : ℕ) (R : Type u) [CommRing R] [DecidableEq R] : Type _ :=
  BoundedCochainComplex (AddKLRWCategory n R)

/-! ### The braiding action on objects

The braiding of the `i`-th and `(i + 1)`-th red strands sends the T-brane at the braided position
`k = i + 1` (the black strand sitting between the two red strands) to the two-term complex
`T_{k-1} ⊕ T_{k+1} ⟶ T_k` in degrees `0` and `1`, with dotless differential; every other
positioning is unchanged, viewed as a complex concentrated in degree `0`. -/

namespace KLRWCategory

/-- A positioning as a one-term cochain complex in degree `0`. -/
def braneComplex (A : KLRWCategory n R) : CochainComplex (AddKLRWCategory n R) ℤ where
  X i := if i = 0 then [A]ₘ else 𝟎
  d _ _ := 0
  shape _ _ _ := rfl
  d_comp_d' _ _ _ _ _ := Limits.zero_comp

/-- The two-term complex `[Tneg, Tpos]ₘ ⟶ [A]ₘ` in degrees `0` and `1`, with dotless differential:
every matrix entry of the differential is the unit strand `StrandSpace.dots R 0`. -/
def braidedBraneComplex (Tneg Tpos A : KLRWCategory n R) :
    CochainComplex (AddKLRWCategory n R) ℤ where
  X i := if i = 0 then [Tneg, Tpos]ₘ else if i = 1 then [A]ₘ else 𝟎
  d i j :=
    if hij : i = 0 ∧ j = 1 then by
      rcases hij with ⟨rfl, rfl⟩
      exact fun _ _ => StrandSpace.dots R 0
    else 0
  shape i j hij := by
    by_cases h01 : i = 0 ∧ j = 1
    · exfalso
      rcases h01 with ⟨rfl, rfl⟩
      exact hij (by simp [ComplexShape.up, ComplexShape.up'])
    · simp [h01]
  d_comp_d' i j l hij hjl := by
    by_cases h01 : i = 0 ∧ j = 1
    · rcases h01 with ⟨rfl, rfl⟩
      rw [dif_pos ⟨rfl, rfl⟩, dif_neg (show ¬((1 : ℤ) = 0 ∧ l = 1) by norm_num), Limits.comp_zero]
    · rw [dif_neg h01]
      exact Limits.zero_comp

/-- `braneComplex A` vanishes outside degree `0`. -/
lemma isZero_braneComplex_X (A : KLRWCategory n R) {i : ℤ} (hi : i ≠ 0) :
    Limits.IsZero ((braneComplex A).X i) := by
  show Limits.IsZero (if i = 0 then _ else _)
  rw [if_neg hi]
  exact isZero_explicitZero

/-- `braidedBraneComplex Tneg Tpos A` vanishes outside degrees `0` and `1`. -/
lemma isZero_braidedBraneComplex_X (Tneg Tpos A : KLRWCategory n R) {i : ℤ} (h0 : i ≠ 0)
    (h1 : i ≠ 1) : Limits.IsZero ((braidedBraneComplex Tneg Tpos A).X i) := by
  show Limits.IsZero (if i = 0 then _ else if i = 1 then _ else _)
  rw [if_neg h0, if_neg h1]
  exact isZero_explicitZero

/-- A positioning as a bounded one-term complex in degree `0`. -/
def brane (A : KLRWCategory n R) : KLRWComplexCategory n R :=
  BoundedCochainComplex.mkOfBounded (braneComplex A) (supersetOfSupport := {0}) fun _ hi =>
    Finset.mem_singleton.mpr (not_not.mp (mt (isZero_braneComplex_X A) hi))

/-- The braided T-brane: the bounded two-term complex `[Tneg, Tpos]ₘ ⟶ [A]ₘ` in degrees `0`
and `1`. -/
def braidedBrane (Tneg Tpos A : KLRWCategory n R) : KLRWComplexCategory n R :=
  BoundedCochainComplex.mkOfBounded (braidedBraneComplex Tneg Tpos A)
    (supersetOfSupport := {0, 1}) fun i hi => by
      rw [Finset.mem_insert, Finset.mem_singleton]
      by_contra hmem
      push Not at hmem
      exact hi (isZero_braidedBraneComplex_X Tneg Tpos A hmem.1 hmem.2)

/-- The braiding action on objects for the transposition of the `i`-th and `(i + 1)`-th red
strands (`i : Fin (n - 1)`, so that only genuine transpositions are expressible): the braided
position is `k = i + 1`, whose T-brane becomes the two-term complex `T_{k-1} ⊕ T_{k+1} ⟶ T_k`;
every other positioning is unchanged. -/
def braidingObj (i : Fin (n - 1)) (A : KLRWCategory n R) : KLRWComplexCategory n R :=
  if A.positioning = (⟨i.val + 1, by have := i.isLt; omega⟩ : Fin (n + 1)) then
    braidedBrane ⟨⟨i.val, by have := i.isLt; omega⟩⟩ ⟨⟨i.val + 2, by have := i.isLt; omega⟩⟩ A
  else
    brane A

end KLRWCategory

end AInfinityTheory
